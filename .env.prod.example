# Copier ce fichier en .env à la racine du VPS (à côté de docker-compose.prod.yml).
# Ce .env n'est jamais commité (voir .gitignore racine).
#
# <IP-VPS-AVEC-TIRETS> = IP publique du VPS, points remplacés par des tirets
# (ex: 51.75.20.10 -> 51-75-20-10). Même valeur à reporter dans apps/web/Caddyfile.

NODE_ENV=production

WEB_ORIGIN=https://app.<IP-VPS-AVEC-TIRETS>.sslip.io

# Consommée comme build arg par le service web (docker-compose.prod.yml), pas
# comme variable d'environnement runtime : Vite la fige dans le bundle au
# moment du build. Toute modification exige un rebuild de l'image web, pas
# juste un restart (voir DEPLOYMENT.md, section 10).
VITE_API_URL=https://api.<IP-VPS-AVEC-TIRETS>.sslip.io

# Secrets applicatifs : générer des valeurs fortes (ex: openssl rand -base64 48
# pour JWT_SECRET), ne jamais réutiliser celles du .env de dev.
JWT_SECRET=
GEMINI_API_KEY=

# MySQL : consommées à la fois par le service mysql (docker-compose.prod.yml)
# et par DATABASE_URL ci-dessous. Mots de passe forts et distincts.
MYSQL_DATABASE=constemps
MYSQL_USER=constemps
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Host "mysql" = nom du service Docker Compose, pas localhost.
# Reporter ici la même valeur que MYSQL_PASSWORD ci-dessus.
DATABASE_URL=mysql://constemps:<meme-valeur-que-MYSQL_PASSWORD>@mysql:3306/constemps
